{
  "name": "@andrea/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:worker": "wrangler dev",
    "build:workerd": "esbuild src/worker.ts --bundle --format=esm --platform=neutral --outfile=../../deploy/workerd/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@andrea/contracts": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.3",
    "wrangler": "^4.12.0"
  },
  "license": "MPL-2.0",
  "author": "AndreaFrederica"
}
